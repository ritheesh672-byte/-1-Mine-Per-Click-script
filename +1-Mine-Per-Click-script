-- +1 Mine Per Click Script | Made by Chilz

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local localPlayer = Players.LocalPlayer

local response = request({
    Url = "https://sirius.menu/rayfield",
    Method = "GET"
})

local Rayfield = loadstring(response.Body)()

local Window = Rayfield:CreateWindow({
    Name = "+1 Mine Per Click Script | Made by Chilz",
    LoadingTitle = "+1 Mine Per Click Script",
    LoadingSubtitle = "Made by Chilz",
    ConfigurationSaving = {Enabled = false}
})

local Tab = Window:CreateTab("Auto Farm", 4483362458)
local PlayerTab = Window:CreateTab("Local Player", 4483362458)
local UpgradesTab = Window:CreateTab("Upgrades", 4483362458)

local autoClick = false
local clicksPerSecond = 5
local autoRebirth = false
local autoSell = false
local autoGoToSurface = false
local autoBuyWalkSpeed = false

local speedBoost = false
local jumpBoost = false
local customSpeed = 50
local customJump = 100

local Remotes = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("Server")
local SellAllLoot = Remotes:WaitForChild("SellAllLoot")
local RebirthEvent = Remotes:WaitForChild("Rebirth")
local GotoSurface = Remotes:WaitForChild("GotoSurface")
local UpgradeWalkspeed = Remotes:WaitForChild("UpgradeWalkspeed")

-- Auto Click Settings
Tab:CreateSection("Auto Click Settings")

Tab:CreateSlider({
    Name = "Click Speed",
    Range = {1, 20},
    Increment = 1,
    Suffix = " clicks/sec",
    CurrentValue = 5,
    Callback = function(value)
        clicksPerSecond = value
    end
})

Tab:CreateToggle({
    Name = "Auto Click",
    CurrentValue = false,
    Callback = function(value)
        autoClick = value
        if value then
            task.spawn(function()
                while autoClick do
                    local character = localPlayer.Character
                    local tool = character and character:FindFirstChildOfClass("Tool")

                    if tool then
                        pcall(function()
                            tool:Activate()
                        end)
                    end

                    task.wait(1 / clicksPerSecond)
                end
            end)
        end
    end
})

-- Auto Rebirth Settings
Tab:CreateSection("Auto Rebirth Settings")

Tab:CreateButton({
    Name = "Rebirth",
    Callback = function()
        pcall(function()
            RebirthEvent:FireServer("Rebirth")
        end)
    end
})

Tab:CreateToggle({
    Name = "Auto Rebirth",
    CurrentValue = false,
    Callback = function(value)
        autoRebirth = value
        if value then
            task.spawn(function()
                while autoRebirth do
                    pcall(function()
                        RebirthEvent:FireServer("Rebirth")
                    end)
                    task.wait(2)
                end
            end)
        end
    end
})

-- Auto Sell Settings
