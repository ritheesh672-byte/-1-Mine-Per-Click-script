-- Upgrades Tab
UpgradesTab:CreateSection("Auto Buy WalkSpeed")

UpgradesTab:CreateToggle({
    Name = "Auto Buy WalkSpeed",
    CurrentValue = false,
    Callback = function(value)
        autoBuyWalkSpeed = value

        if value then
            task.spawn(function()
                while autoBuyWalkSpeed do
                    pcall(function()
                        UpgradeWalkspeed:FireServer("Cash")
                    end)
                    task.wait(1)
                end
            end)
        end
    end
})

-- Update movement settings
local function updateMovement()
    local character = localPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")

    if not humanoid then
        return
    end

    humanoid.WalkSpeed = speedBoost and customSpeed or 16
    humanoid.UseJumpPower = true
    humanoid.JumpPower = jumpBoost and customJump or 50
end

-- Custom Speed Settings
PlayerTab:CreateSection("Custom Speed")

PlayerTab:CreateSlider({
    Name = "Speed Amount",
    Range = {16, 200},
    Increment = 1,
    Suffix = " speed",
    CurrentValue = 50,
    Callback = function(value)
        customSpeed = value
        updateMovement()
    end
})

PlayerTab:CreateToggle({
    Name = "Speed Boost",
    CurrentValue = false,
    Callback = function(value)
        speedBoost = value
        updateMovement()
    end
})

-- Custom Jump Boost Settings
PlayerTab:CreateSection("Custom Jump Boost")

PlayerTab:CreateSlider({
    Name = "Jump Amount",
    Range = {50, 200},
    Increment = 5,
    Suffix = " power",
    CurrentValue = 100,
    Callback = function(value)
        customJump = value
        updateMovement()
    end
})

PlayerTab:CreateToggle({
    Name = "Jump Boost",
    CurrentValue = false,
    Callback = function(value)
        jumpBoost = value
        updateMovement()
    end
})

-- Restore movement settings after respawning
localPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)
    updateMovement()
end)
